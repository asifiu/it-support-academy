{
  "name": "IT Support Academy",
  "short_name": "IT Academy",
  "description": "Career change into IT: career tracks for IT support, system administration and network engineering, Cisco CLI labs, Microsoft 365, Azure, Linux, ITIL and German for the workplace.",
